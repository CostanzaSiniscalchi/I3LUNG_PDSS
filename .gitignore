# Ignore everything by default
*

# Core git files
!.gitignore
!.gitattributes

# Root-level tracked files
!README.md
!Metadata_Extraction.ipynb
!data_visualization.ipynb
!fairness_analysis.ipynb
!graphs_classification.ipynb
!graphs_survival_analysis.ipynb

# data/ - only specific files
!data/
!data/features.json
!data/int_cv_splits.json


# dlif_pipeline/ - whitelist tree, then exclude heavy dirs
!dlif_pipeline/
!dlif_pipeline/**
dlif_pipeline/bags/
dlif_pipeline/configs/
dlif_pipeline/results/
dlif_pipeline/preds/
dlif_pipeline/scripts/
dlif_pipeline/debug/
dlif_pipeline/MIL.log
dlif_pipeline/df.parquet
dlif_pipeline/structure.txt
dlif_pipeline/pipeline/train/MIL.log
dlif_pipeline/pipeline/plotting/line_no_plot_other_metrics.py



# images/
!images/
!images/**

# mlef_pipeline/
!mlef_pipeline/
!mlef_pipeline/**
mlef_pipeline/results/
mlef_pipeline/scripts/


# vanguri/
!other_models/
!other_models/**
other_models/vanguri/.ipynb_checkpoints/
other_models/vanguri/results/

# utils/
!utils/
!utils/**



# Always ignore compiled/cache files
__pycache__/
*.pyc
